# MariaDB container credentials. Use long random values without URL-reserved
# characters so DB_PASSWORD can be embedded safely in DATABASE_URL.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Local development can point to any MySQL/MariaDB instance. Docker Compose
# overrides this value to use its private `database` service.
DATABASE_URL=mysql://tonalizador:change-me@127.0.0.1:3306/tonalizador

# Spotify is used only to identify tracks; ReccoBeats supplies tonal features.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=ES

# Optional deployment metadata
APP_ID=
